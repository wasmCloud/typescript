{
  "name": "service-tcp-echo-service",
  "version": "0.1.0",
  "description": "TCP word-count service (wasi:cli/run service workload)",
  "private": true,
  "main": "dist/service.js",
  "type": "module",
  "scripts": {
    "fetch:wit": "wash wit fetch",
    "generate:types": "rimraf generated/types && jco guest-types wit/ -o generated/types",
    "setup:wit": "npm run fetch:wit && npm run generate:types",
    "build:ts": "rolldown -c rolldown.config.mjs",
    "build:component": "node scripts/componentize.mjs",
    "build": "npm run setup:wit && npm run build:ts && npm run build:component",
    "test": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@bytecodealliance/jco": "^1.42.0",
    "@vitest/coverage-v8": "^5.1.1",
    "rimraf": "^6.1.4",
    "rolldown": "^1.3.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
