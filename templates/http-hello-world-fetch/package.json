{
  "name": "http-hello-world",
  "version": "0.1.0",
  "description": "A minimal WebAssembly component that responds to HTTP requests with a hello world message",
  "private": true,
  "type": "module",
  "main": "dist/component.js",
  "scripts": {
    "fetch:wit": "wash wit fetch",
    "generate:types": "rimraf generated/types && jco guest-types wit/ -o generated/types",
    "setup:wit": "npm run fetch:wit && npm run generate:types",
    "build:ts": "tsc",
    "build:component": "jco componentize -w wit -o dist/http_hello_world.wasm dist/component.js",
    "build": "npm run setup:wit && npm run build:ts && npm run build:component",
    "serve": "jco serve dist/http_hello_world.wasm",
    "dev": "nodemon",
    "test": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@bytecodealliance/jco": "^1.42.0",
    "@vitest/coverage-v8": "^5.1.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.2"
    },
    "@bytecodealliance/jco-std": {
      "minimatch": "^11.0.2"
    },
    "glob": {
      "minimatch": "^11.0.2"
    }
  }
}
