package wasmcloud:webgpu-tensorflow@0.1.0;

world service {
  // GPU access for TensorFlow.js's WebGPU backend
  import wasi:webgpu/webgpu@0.3.0-rc.2;

  // TCP server for the loopback request protocol
  import wasi:sockets/types@0.3.0;

  // Backs the console polyfill
  import wasi:cli/stdout@0.3.0;
  import wasi:cli/stderr@0.3.0;

  export wasi:cli/run@0.3.0;
}
