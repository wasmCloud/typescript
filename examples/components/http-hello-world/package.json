{
  "name": "http-hello-world",
  "version": "0.1.0",
  "description": "A WebAssembly component that responds to HTTP requests using the `wasi:http` WIT interface",
  "main": "dist/http-hello-world.js",
  "scripts": {
    "generate:types": "rimraf generated/types && jco guest-types wit/ -o generated/types",
    "build:ts": "tsc",
    "build:js": "jco componentize -w wit -o dist/http-hello-world.wasm dist/http-hello-world.js",
    "install:deps": "rimraf wit/deps && wash wit fetch",
    "build": "npm run install:deps && npm run generate:types && npm run build:ts && npm run build:js",
    "install-and-build": "npm install && npm run build",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@bytecodealliance/jco": "^1.40.0",
    "@types/node": "^26.6.6",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.2"
    },
    "@bytecodealliance/jco-std": {
      "minimatch": "^11.0.2"
    },
    "glob": {
      "minimatch": "^11.0.2"
    }
  }
}
