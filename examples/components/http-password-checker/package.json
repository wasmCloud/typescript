{
  "name": "ts-http-password-checker",
  "version": "0.1.0",
  "description": "",
  "main": "dist/http-password-checker.js",
  "type": "module",
  "scripts": {
    "generate:types": "rimraf generated/types && jco guest-types wit/ -o generated/types",
    "build:ts": "rolldown -c rolldown.config.mjs",
    "build:js": "jco componentize -w wit -o dist/http-password-checker.wasm dist/http-password-checker.js",
    "install:deps": "rimraf wit/deps && wash wit fetch",
    "build": "npm run install:deps && npm run generate:types && npm run build:ts && npm run build:js",
    "install-and-build": "npm install && npm run build",
    "serve": "jco serve dist/http-password-checker.wasm",
    "dev": "nodemon",
    "test": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@bytecodealliance/jco": "^1.40.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.4",
    "rolldown": "^1.2.16",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "check-password-strength": "^3.0.0",
    "valibot": "^1.5.0"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.2"
    },
    "@bytecodealliance/jco-std": {
      "minimatch": "^11.0.2"
    },
    "glob": {
      "minimatch": "^11.0.2"
    }
  }
}
